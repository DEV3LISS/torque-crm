{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "torque-crm",
    "Audience": "torque-crm-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Business": {
    "TimeZone": "Asia/Yekaterinburg"
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalSeconds": 15,
    "BatchSize": 20
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 5
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
